# Kolofon static asset headers.
#
# Scoped to the theme's assets/ directory: it only affects files served from
# here (CSS, JS, fonts, images), never the site's PHP or the WordPress root.
#
# It answers two PageSpeed findings that are HTTP-header level, not code:
#   - "Use efficient cache lifetimes" — assets were served with no cache policy.
#   - "No compression applied" — text assets were served uncompressed.
#
# Every directive is wrapped in an <IfModule> guard, so on a host where the
# module is not loaded this file does nothing rather than erroring. It is
# Apache-only: on nginx it is ignored and the equivalent must be set in the
# server config instead.
#
# Long max-age is safe because the theme versions CSS and JS with a ?ver query
# tied to the theme version, so a release bumps the URL and busts the cache.

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/css
		AddOutputFilterByType DEFLATE text/javascript
		AddOutputFilterByType DEFLATE application/javascript
		AddOutputFilterByType DEFLATE image/svg+xml
		AddOutputFilterByType DEFLATE application/json
	</IfModule>
</IfModule>

# --- Cache lifetimes (Expires) --------------------------------------------
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css                "access plus 1 year"
	ExpiresByType text/javascript         "access plus 1 year"
	ExpiresByType application/javascript  "access plus 1 year"
	ExpiresByType image/webp              "access plus 1 year"
	ExpiresByType image/png               "access plus 1 year"
	ExpiresByType image/jpeg              "access plus 1 year"
	ExpiresByType image/gif               "access plus 1 year"
	ExpiresByType image/svg+xml           "access plus 1 year"
	ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# --- Cache lifetimes (Cache-Control fallback) -----------------------------
# Covers hosts with mod_headers but not mod_expires, and adds immutable.
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|webp|png|jpe?g|gif|svg|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
