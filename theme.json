{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "background", "color": "var(--k-bg)",     "name": "Background" },
				{ "slug": "text",       "color": "var(--k-text)",   "name": "Text" },
				{ "slug": "accent",     "color": "var(--k-accent)", "name": "Accent" },
				{ "slug": "muted",      "color": "var(--k-muted)",  "name": "Muted" },
				{ "slug": "rule",       "color": "var(--k-rule)",   "name": "Rule" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small",   "size": "0.9rem",  "name": "Small" },
				{ "slug": "medium",  "size": "1rem",    "name": "Medium" },
				{ "slug": "large",   "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.65rem", "name": "X-Large" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"padding": true,
			"margin": true,
			"units": [ "px", "em", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem",  "name": "1" },
				{ "slug": "30", "size": "1rem",    "name": "2" },
				{ "slug": "40", "size": "1.5rem",  "name": "3" },
				{ "slug": "50", "size": "2.5rem",  "name": "4" },
				{ "slug": "60", "size": "4rem",    "name": "5" }
			]
		},
		"layout": {
			"contentSize": "var(--k-container)",
			"wideSize": "calc(var(--k-container) + 200px)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--k-bg)",
			"text": "var(--k-text)"
		},
		"typography": {
			"fontFamily": "var(--k-font-body)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "var(--k-accent)" } },
			"heading": {
				"typography": { "fontFamily": "var(--k-font-heading)", "lineHeight": "1.2" }
			}
		}
	}
}
